{
  "_comment": "Vectores dorados del AST de condiciones de drbac (Fase F4 del plan rbac/drbac). Los consume tests/test_darwin_drbac_conditions.py (pytest) y, desde la Fase F6, el equivalente en vitest — el mismo resultado en las dos runtimes es lo que este archivo fija. `expected` es `true`/`false`/`null` (`null` = indeterminado). Deliberadamente no incluye `predicate`: un predicado se registra en código, por runtime, y no es parte del AST portable.",
  "vectors": [
    {
      "name": "eq_true",
      "condition": {
        "type": "eq",
        "left": { "type": "var", "path": "resource.owner_id" },
        "right": { "type": "var", "path": "subject.id" }
      },
      "context": { "subject": { "id": "u1" }, "resource": { "owner_id": "u1" }, "env": {} },
      "expected": true
    },
    {
      "name": "eq_false",
      "condition": {
        "type": "eq",
        "left": { "type": "var", "path": "resource.owner_id" },
        "right": { "type": "var", "path": "subject.id" }
      },
      "context": { "subject": { "id": "u1" }, "resource": { "owner_id": "u2" }, "env": {} },
      "expected": false
    },
    {
      "name": "ne_true",
      "condition": {
        "type": "ne",
        "left": { "type": "var", "path": "resource.status" },
        "right": { "type": "const", "value": "archived" }
      },
      "context": { "subject": {}, "resource": { "status": "draft" }, "env": {} },
      "expected": true
    },
    {
      "name": "gt_true",
      "condition": {
        "type": "gt",
        "left": { "type": "var", "path": "resource.amount" },
        "right": { "type": "const", "value": 1000 }
      },
      "context": { "subject": {}, "resource": { "amount": 1500 }, "env": {} },
      "expected": true
    },
    {
      "name": "gte_equal_is_true",
      "condition": {
        "type": "gte",
        "left": { "type": "var", "path": "resource.amount" },
        "right": { "type": "const", "value": 1000 }
      },
      "context": { "subject": {}, "resource": { "amount": 1000 }, "env": {} },
      "expected": true
    },
    {
      "name": "lt_false",
      "condition": {
        "type": "lt",
        "left": { "type": "var", "path": "resource.amount" },
        "right": { "type": "const", "value": 1000 }
      },
      "context": { "subject": {}, "resource": { "amount": 1500 }, "env": {} },
      "expected": false
    },
    {
      "name": "lte_incomparable_types_is_indeterminate",
      "condition": {
        "type": "lte",
        "left": { "type": "var", "path": "resource.amount" },
        "right": { "type": "const", "value": "no-es-numero" }
      },
      "context": { "subject": {}, "resource": { "amount": 1500 }, "env": {} },
      "expected": null
    },
    {
      "name": "in_true",
      "condition": {
        "type": "in",
        "left": { "type": "var", "path": "resource.status" },
        "right": { "type": "const", "value": ["draft", "pending"] }
      },
      "context": { "subject": {}, "resource": { "status": "draft" }, "env": {} },
      "expected": true
    },
    {
      "name": "in_false",
      "condition": {
        "type": "in",
        "left": { "type": "var", "path": "resource.status" },
        "right": { "type": "const", "value": ["draft", "pending"] }
      },
      "context": { "subject": {}, "resource": { "status": "approved" }, "env": {} },
      "expected": false
    },
    {
      "name": "contains_true",
      "condition": {
        "type": "contains",
        "left": { "type": "var", "path": "resource.tags" },
