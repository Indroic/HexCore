    {
      "name": "and_all_true_is_true",
      "condition": {
        "type": "and",
        "items": [
          { "type": "eq", "left": { "type": "var", "path": "resource.owner_id" }, "right": { "type": "var", "path": "subject.id" } },
          { "type": "in", "left": { "type": "var", "path": "resource.status" }, "right": { "type": "const", "value": ["draft"] } }
        ]
      },
      "context": { "subject": { "id": "u1" }, "resource": { "owner_id": "u1", "status": "draft" }, "env": {} },
