    {
      "name": "nested_or_of_ands_no_self_approval_example",
      "_comment": "Aproxima el ejemplo del plan: permití update si sos el dueño y el estado es draft, o si el estado es pending y sos el aprobador.",
      "condition": {
        "type": "or",
        "items": [
          {
            "type": "and",
            "items": [
              { "type": "eq", "left": { "type": "var", "path": "resource.owner_id" }, "right": { "type": "var", "path": "subject.id" } },
              { "type": "in", "left": { "type": "var", "path": "resource.status" }, "right": { "type": "const", "value": ["draft"] } }
            ]
          },
          {
            "type": "and",
            "items": [
