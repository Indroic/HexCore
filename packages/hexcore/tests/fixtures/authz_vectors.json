          { "type": "eq", "left": { "type": "const", "value": 1 }, "right": { "type": "const", "value": 1 } },
          { "type": "eq", "left": { "type": "var", "path": "resource.does_not_exist" }, "right": { "type": "const", "value": 1 } }
        ]
      },
      "context": { "subject": {}, "resource": {}, "env": {} },
      "expected": null
    },
    {
      "name": "or_one_true_dominates_indeterminate",
