        "left": { "type": "var", "path": "resource.scope_path" },
        "right": { "type": "const", "value": "org:4" }
      },
      "context": { "subject": {}, "resource": { "scope_path": "org:42/project:7" }, "env": {} },
      "expected": false
    },
    {
      "name": "within_scope_unrelated_branch_is_false",
      "condition": {
        "type": "within_scope",
        "left": { "type": "var", "path": "resource.scope_path" },
        "right": { "type": "const", "value": "org:42/project:7" }
