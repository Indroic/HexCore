      "context": { "subject": {}, "resource": { "scope_path": "org:42/project:7" }, "env": {} },
      "expected": true
    },
    {
      "name": "within_scope_descendant_is_true",
      "condition": {
        "type": "within_scope",
        "left": { "type": "var", "path": "resource.scope_path" },
        "right": { "type": "const", "value": "org:42" }
      },
      "context": { "subject": {}, "resource": { "scope_path": "org:42/project:7" }, "env": {} },
      "expected": true
