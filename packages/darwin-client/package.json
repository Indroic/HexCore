{
  "name": "@hexcore-js/darwin-client",
  "version": "1.0.0",
  "description": "Framework-, runtime- and backend-agnostic TypeScript client for Darwin, the identity module of HexCore. Zero runtime dependencies.",
  "keywords": [
    "darwin",
    "hexcore",
    "auth",
    "authentication",
    "identity",
    "session",
    "jwt",
    "csrf",
    "webauthn",
    "passkey",
    "totp",
    "2fa",
    "oauth",
    "magic-link",
    "multi-tenancy",
    "typescript"
  ],
  "homepage": "https://github.com/Indroic/HexCore/tree/master/docs/darwin-client/en",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indroic/HexCore.git",
    "directory": "packages/darwin-client"
  },
  "bugs": {
    "url": "https://github.com/Indroic/HexCore/issues"
  },
  "author": {
    "name": "David Latosefki (Indroic)",
    "email": "indroic@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webauthn": {
      "types": "./dist/webauthn.d.ts",
      "import": "./dist/webauthn.js",
      "require": "./dist/webauthn.cjs"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js",
      "require": "./dist/store.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gen:schema": "openapi-typescript openapi/darwin.openapi.json -o src/generated/schema.d.ts",
    "gen:errors": "node scripts/gen-error-codes.mjs",
    "gen:errors:check": "node scripts/gen-error-codes.mjs --check",
    "gen": "npm run gen:schema && npm run gen:errors"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
