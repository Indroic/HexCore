.venv
.ruff_cache
__pycache__
.mypy_cache
*.egg-info
# Artefactos de build. Antes no estaban ignorados y `python -m build` dejaba `build/` y
# `dist/` sucios en el árbol — al punto de que `dist` terminó publicándose como paquete
# top-level en la wheel.
build/
dist/
# Reportes del gate de tipado
pyright.json
verifytypes.json
# Índice local de CodeGraph (no es artefacto del proyecto)
.codegraph/
# Bases SQLite locales. El default de `ServerConfig.async_sql_database_url` es
# `sqlite+aiosqlite:///./db.sqlite3`, así que cualquier corrida que levante el engine sin
# configuración —un test, un `hexcore identity create-tables`, un script— deja el archivo en
# la raíz del repo.
*.sqlite3
# Node (workspace npm de packages/darwin-client)
node_modules/
npm-debug.log*
.npm/
*.tsbuildinfo

# Claude Code: se versiona `.claude/settings.json` —es lo que habilita el plugin local que
# expone `skills/`— y nada más. Lo de abajo es estado de cada máquina.
.claude/settings.local.json
.claude/*.lock
